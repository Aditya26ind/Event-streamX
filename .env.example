# EventStreamX Environment Configurations
# Copy and modify these variables for different scaling scenarios

# =============================================================================
# DEVELOPMENT ENVIRONMENT (Single Node)
# =============================================================================
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=events
# KAFKA_DLQ_TOPIC=events-dlq
# KAFKA_GROUP_ID=eventstreamx-consumer
# KAFKA_BATCH_SIZE=100
# KAFKA_POLL_TIMEOUT_MS=1000
# PRODUCER_BATCH_SIZE=10
# KAFKA_CONNECT_RETRIES=5
# KAFKA_CONNECT_RETRY_BACKOFF_SECONDS=3
# KAFKA_SAVE_RETRIES=3
# KAFKA_SAVE_RETRY_BACKOFF_SECONDS=2

# =============================================================================
# STAGING ENVIRONMENT (3 Brokers, 3 Consumers)
# =============================================================================
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096
# KAFKA_TOPIC=events
# KAFKA_DLQ_TOPIC=events-dlq
# KAFKA_GROUP_ID=eventstreamx-consumer-group
# KAFKA_BATCH_SIZE=1000
# KAFKA_POLL_TIMEOUT_MS=1000
# PRODUCER_BATCH_SIZE=100
# KAFKA_CONNECT_RETRIES=10
# KAFKA_CONNECT_RETRY_BACKOFF_SECONDS=5
# KAFKA_SAVE_RETRIES=3
# KAFKA_SAVE_RETRY_BACKOFF_SECONDS=2

# =============================================================================
# PRODUCTION ENVIRONMENT (High Throughput)
# =============================================================================
# KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
# KAFKA_TOPIC=events
# KAFKA_DLQ_TOPIC=events-dlq
# KAFKA_GROUP_ID=eventstreamx-consumer-group
# KAFKA_BATCH_SIZE=5000
# KAFKA_POLL_TIMEOUT_MS=500
# PRODUCER_BATCH_SIZE=500
# KAFKA_CONNECT_RETRIES=15
# KAFKA_CONNECT_RETRY_BACKOFF_SECONDS=10
# KAFKA_SAVE_RETRIES=5
# KAFKA_SAVE_RETRY_BACKOFF_SECONDS=5

# =============================================================================
# ENTERPRISE ENVIRONMENT (Maximum Scale)
# =============================================================================
# KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092,kafka-4:9092,kafka-5:9092
# KAFKA_TOPIC=events
# KAFKA_DLQ_TOPIC=events-dlq
# KAFKA_GROUP_ID=eventstreamx-consumer-group
# KAFKA_BATCH_SIZE=10000
# KAFKA_POLL_TIMEOUT_MS=200
# PRODUCER_BATCH_SIZE=1000
# KAFKA_CONNECT_RETRIES=20
# KAFKA_CONNECT_RETRY_BACKOFF_SECONDS=15
# KAFKA_SAVE_RETRIES=10
# KAFKA_SAVE_RETRY_BACKOFF_SECONDS=10

# =============================================================================
# LOAD TESTING CONFIGURATION
# =============================================================================
# TEST_DURATION_SECONDS=300
# TARGET_THROUGHPUT_EPS=5000
# NUM_PRODUCERS=8
# NUM_CONSUMERS=6

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# S3_STORAGE_ENABLED=true
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET_NAME=eventstreamx-data
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_DEFAULT_REGION=us-east-1
# PRODUCTION_MODE=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# PROMETHEUS_ENABLED=false
# METRICS_PORT=9090
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# JVM_OPTS=-Xmx4g -Xms2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200
# KAFKA_HEAP_OPTS=-Xmx2g -Xms1g
# MINIO_MEMORY_LIMIT=2g
# CONTAINER_CPU_LIMIT=2.0
# CONTAINER_MEMORY_LIMIT=4g